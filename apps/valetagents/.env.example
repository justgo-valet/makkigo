# 요원·업체 관리자 앱 로컬 개발용

# ── 데이터베이스 · 인증 ─────────────────────────────────────────────────────
DATABASE_URL=
AUTH_JWT_SECRET=

# ── 서비스 주소 ─────────────────────────────────────────────────────────────
PUBLIC_URL=http://localhost:3000
# OAuth 제공자 웹 콜백 주소를 만드는 기준 URL (필수)
# 운영: https://app.makkigo.com
OAUTH_CALLBACK_ORIGIN=http://localhost:3000
# Flutter 요원 앱의 OAuth 복귀 주소 (웹 로그인만 확인할 때는 기본값 사용 가능)
APP_CALLBACK_URL=com.makkigo.valetagent://auth
# 운영 전용: 콜백 검증용 CSRF 쿠키를 두 서브도메인에 공유
# 운영: .makkigo.com / 로컬: 빈 값
AUTH_COOKIE_DOMAIN=

# ── 소셜 로그인 ─────────────────────────────────────────────────────────────
# 사용하지 않는 제공자는 비워 둘 수 있습니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
# 카카오맵 JavaScript 키. 서버가 읽어 화면에 넘기므로 NEXT_PUBLIC_ 을 붙이지 않습니다.
KAKAO_MAP_APP_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICES_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 업체 이미지 저장소 · CDN ───────────────────────────────────────────────
AWS_REGION=ap-northeast-2
S3_IMAGE_BUCKET=
# 서버가 응답 URL을 조합하는 공개 CloudFront 기준 URL
IMAGE_BASE_URL=

# ── 앱 푸시 (FCM) ── 고객에게 주차 완료 알림을 보냄. 고객 앱과 같은 값 ────────────
# 비우면 알림 내역만 남고 푸시는 나가지 않음
FIREBASE_SERVICE_ACCOUNT_JSON=

# 32 bytes 이상 무작위 값. 앱과 cleanup runner가 같은 값을 읽습니다.
MERCHANT_UPLOAD_CLEANUP_TOKEN=
# 로컬 기본값도 false. 실제 삭제는 운영 절차(runbook)를 거친 뒤 true 로 바꿉니다.
MERCHANT_UPLOAD_CLEANUP_ENABLED=false
MERCHANT_UPLOAD_CLEANUP_ALERT_WEBHOOK_URL=

# ── 요원 알림 자동 전환 ── 근무 시작 · 끝 시각에 알림을 켜고 끄는 runner 가 내부 API 를 부를 때 씀 ──
# 32 bytes 이상 무작위 값(openssl rand -base64 32). 앱과 runner 가 같은 값을 읽습니다.
AGENT_NOTIFICATION_SYNC_TOKEN=
