# 요원·업체 관리자 앱 로컬 개발용

# ── 데이터베이스 · 인증 ─────────────────────────────────────────────────────
DATABASE_URL=
AUTH_JWT_SECRET=

# ── 서비스 주소 ─────────────────────────────────────────────────────────────
PUBLIC_URL=http://localhost:3000
# OAuth 제공자 웹 콜백 주소를 만드는 기준 URL (필수)
# 운영: https://app.makkigo.com
OAUTH_CALLBACK_ORIGIN=http://localhost:3000
# Flutter 요원 앱의 OAuth 복귀 주소 (웹 로그인만 확인할 때는 기본값 사용 가능)
APP_CALLBACK_URL=com.makkigo.valetagent://auth
# 운영 전용: 콜백 검증용 CSRF 쿠키를 두 서브도메인에 공유
# 운영: .makkigo.com / 로컬: 빈 값
AUTH_COOKIE_DOMAIN=

# ── 소셜 로그인 ─────────────────────────────────────────────────────────────
# 사용하지 않는 제공자는 비워 둘 수 있습니다.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICES_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ── 이미지 CDN ──────────────────────────────────────────────────────────────
# 브라우저에서도 사용하는 공개 기준 URL
NEXT_PUBLIC_IMAGE_BASE_URL=
