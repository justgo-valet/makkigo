# 요원·업체 관리자 앱 로컬 개발용
DATABASE_URL=
AUTH_JWT_SECRET=
PUBLIC_URL=http://localhost:3000
# Flutter 요원 앱의 OAuth 복귀 주소
APP_CALLBACK_URL=com.makkigo.valetagent://auth
# 제공자 OAuth 웹 콜백은 고객 앱과 같은 도메인에서 받습니다.
OAUTH_CALLBACK_ORIGIN=http://localhost:3000
# 운영에서는 콜백 검증용 CSRF 쿠키만 두 서브도메인에 공유합니다: .makkigo.com
AUTH_COOKIE_DOMAIN=

KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICES_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
