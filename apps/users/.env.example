# 고객 앱 로컬 개발용
# 사용법: cp .env.example .env.development.local  (이 폴더에서) → 값을 채운 파일은 커밋하지 않습니다.
# 운영 값은 SSM Parameter Store /makkigo/prod/users/ 에 둡니다 → .env.production.example, docs/architecture/deployment.md

# ── 데이터베이스 ─────────────────────────────────────────────────────────────
# 예: postgresql://<사용자>:<비밀번호>@localhost:5432/<DB>
DATABASE_URL=

# ── 우리 토큰 서명 키 ── 생성: openssl rand -base64 32 ──────────────────────
AUTH_JWT_SECRET=

# ── 이 앱 주소 ── 소셜 로그인 콜백 주소를 만듭니다 ─────────────────────────
PUBLIC_URL=http://localhost:3001

# ── 이미지 CDN 주소 ── DB 의 이미지 경로(brands/kia.png)와 합쳐 전체 주소를 만듭니다 ──
IMAGE_BASE_URL=https://d2lnojrmgxqgrc.cloudfront.net

# ── 카카오맵 JavaScript 키 ── 업체 상세 지도. 카카오 콘솔 → 플랫폼 → Web 에 http://localhost:3001 등록 ──
# 비우면 지도 대신 안내 문구가 뜸
KAKAO_MAP_APP_KEY=

# ── 앱 푸시 (FCM) ── Firebase 콘솔 → 프로젝트 설정 → 서비스 계정 → 새 비공개 키 ──
# 받은 JSON 파일 내용을 한 줄로: jq -c . <키 파일>.json
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── 소셜 로그인 (웹 OAuth) ── 콘솔 설정: docs/architecture/auth.md ──────────
# 카카오 REST API 키
KAKAO_REST_API_KEY=
# 카카오 Client Secret (보안 설정에서 사용할 때만)
KAKAO_CLIENT_SECRET=
# 구글 웹 애플리케이션 클라이언트 ID · 보안 비밀번호
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 애플 Services ID (로컬 http 로는 애플 로그인을 할 수 없음)
APPLE_SERVICES_ID=
# 애플 탈퇴 토큰 철회용 팀 ID · 키 ID · .p8 내용(한 줄, 줄바꿈은 \n). 비우면 철회를 건너뜀
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# 네이버 Client ID · Secret
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 정기 작업 내부 API 인증 값 (32바이트 이상, openssl rand -hex 32). 비우면 내부 API 가 모두 401
USERS_INTERNAL_JOB_TOKEN=
