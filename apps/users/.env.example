# 고객 앱 로컬 개발용
# 사용법: cp .env.example .env.development.local  (이 폴더에서) → 값을 채운 파일은 커밋하지 않습니다.
# 운영 값은 SSM Parameter Store /makkigo/prod/users/ 에 둡니다 → .env.production.example, docs/architecture/deployment.md

# ── 데이터베이스 ─────────────────────────────────────────────────────────────
# 예: postgresql://<사용자>:<비밀번호>@localhost:5432/<DB>
DATABASE_URL=

# ── 우리 토큰 서명 키 ── 생성: openssl rand -base64 32 ──────────────────────
AUTH_JWT_SECRET=

# ── 소셜 로그인 ──────────────────────────────────────────────────────────────
# 카카오 개발자 콘솔의 앱 ID (숫자)
KAKAO_APP_ID=
# 구글 iOS 클라이언트 ID (iOS 에서도 serverClientId 를 쓰면 아래와 같은 값)
GOOGLE_IOS_CLIENT_ID=
# 구글: Flutter google_sign_in 의 serverClientId (웹 유형 클라이언트 ID)
GOOGLE_ANDROID_CLIENT_ID=
# 애플: iOS 앱 번들 ID
APPLE_BUNDLE_ID=
# 네이버 클라이언트 ID — 현재 토큰 검증에 쓰이지 않음 (docs/architecture/auth.md)
NAVER_CLIENT_ID=
