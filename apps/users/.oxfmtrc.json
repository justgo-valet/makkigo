{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "arrowParens": "always",
  "bracketSpacing": true,
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "insertFinalNewline": true,
  "sortPackageJson": true,
  "sortTailwindcss": {
    "stylesheet": "./app/globals.css"
  },
  "ignorePatterns": [".next/**", "dist/**", "out/**", "coverage/**"],
  "sortImports": {
    "internalPattern": ["@/"],
    "newlinesBetween": true,
    "sortSideEffects": false,
    "groups": [
      "builtin",
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "style",
      "unknown",
      "type"
    ]
  }
}
