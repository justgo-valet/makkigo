# 업체 관리자 포털 로컬 개발용 (요원 앱과 같은 DB · 인증 비밀값을 씁니다)

DATABASE_URL=
AUTH_JWT_SECRET=

# 이 앱의 공개 주소. 운영: https://tickets.makkigo.com
PUBLIC_URL=http://localhost:3002
# 업체 QR 이 여는 고객 앱 주소. 운영: https://app.makkigo.com
USERS_PUBLIC_URL=http://localhost:3001
# 파트너 앱 안에서 로그인 화면에 "파트너 로그인으로 돌아가기"를 보여 줄 요원 앱 주소. 운영: https://valet.makkigo.com
VALET_PUBLIC_URL=http://localhost:3000

# 티켓 이미지 저장소 · CDN (요원 앱과 같은 값)
AWS_REGION=ap-northeast-2
S3_IMAGE_BUCKET=
IMAGE_BASE_URL=
