# 티켓 관리 웹 로컬 개발용 (요원 앱과 같은 DB · 인증 비밀값을 씁니다)

DATABASE_URL=
AUTH_JWT_SECRET=

# 이 앱의 공개 주소. 운영: https://tickets.makkigo.com
PUBLIC_URL=http://localhost:3002
# 소셜 로그인 콜백을 받는 요원 앱 기준 URL. 요원 앱 .env 의 값과 같게 둡니다.
# 운영: https://app.makkigo.com
OAUTH_CALLBACK_ORIGIN=http://localhost:3000
# 운영 전용: 로그인 확인용 쿠키를 요원 앱 콜백과 나눠 씀. 운영: .makkigo.com / 로컬: 빈 값
AUTH_COOKIE_DOMAIN=

# 소셜 로그인 (요원 앱과 같은 값)
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICES_ID=

# 티켓 이미지 저장소 · CDN (요원 앱과 같은 값)
AWS_REGION=ap-northeast-2
S3_IMAGE_BUCKET=
IMAGE_BASE_URL=
