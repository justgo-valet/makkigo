# 슈퍼 어드민 콘솔 로컬 개발용 (요원 앱과 같은 DB · 인증 비밀값을 씁니다)

DATABASE_URL=
AUTH_JWT_SECRET=

# 이 앱의 공개 주소. 운영: https://admin.makkigo.com
PUBLIC_URL=http://localhost:3003

# 업체 추가 때 카카오 장소 검색 (요원 앱과 같은 REST API 키, 서버에서만 씀)
KAKAO_REST_API_KEY=

# 업체 사진 저장소 · CDN (요원 앱과 같은 값)
AWS_REGION=ap-northeast-2
S3_IMAGE_BUCKET=
IMAGE_BASE_URL=

# 업체 QR 에 담는 고객 앱 주소 (요원 앱과 같은 값). 운영: https://app.makkigo.com
USERS_PUBLIC_URL=http://localhost:3001
