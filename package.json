{
  "name": "makkigo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "dev:valetagents": "pnpm --filter @makkigo/valetagents dev",
    "dev:users": "pnpm --filter @makkigo/users dev",
    "build": "pnpm --filter './apps/*' build",
    "lint": "pnpm --filter './apps/*' lint",
    "start:valetagents": "pnpm --filter @makkigo/valetagents start",
    "start:users": "pnpm --filter @makkigo/users start",
    "typecheck": "pnpm --filter './apps/*' typecheck",
    "db:generate": "pnpm --filter database generate",
    "db:format": "pnpm --filter database format",
    "db:validate": "pnpm --filter database validate",
    "db:migrate:dev": "pnpm --filter database migrate:dev",
    "db:migrate:deploy": "pnpm --filter database migrate:deploy",
    "db:studio": "pnpm --filter database studio"
  },
  "packageManager": "pnpm@12.6.0"
}
