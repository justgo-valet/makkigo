# 로컬 개발용 (docker compose · Prisma)
# 사용법: cp .env.example .env.development  → 값을 채운 .env.development 는 커밋하지 않습니다.
# 고객 앱(Next.js)은 이 파일이 아니라 apps/users/.env.example 을 씁니다.

# ── PostgreSQL 컨테이너 ──────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── Prisma (마이그레이션 · Studio) ───────────────────────────────────────────
# 예: postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:5432/<POSTGRES_DB>
DATABASE_URL=
