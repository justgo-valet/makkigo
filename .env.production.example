# 운영 환경변수 목록 (참고용 — 이 파일을 서버에 두지 않습니다)
# 운영 값은 SSM Parameter Store 에 둡니다. 각 줄 위 주석이 파라미터 경로입니다.
# 규칙과 설정 방법: docs/architecture/deployment.md

# ── PostgreSQL 컨테이너 ─ /makkigo/prod/postgres/<이름> ─────────────────────
POSTGRES_USER=
# 영문 · 숫자로 길게 (특수문자는 DATABASE_URL 에서 깨짐)
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── 고객 앱 ─ /makkigo/prod/users/<이름> ────────────────────────────────────
# 호스트는 localhost 가 아니라 DB 컨테이너 이름: postgresql://<사용자>:<비밀번호>@postgres:5432/<DB>
DATABASE_URL=
# 개발용과 다른 값 (openssl rand -base64 32)
AUTH_JWT_SECRET=
# https://app.makkigo.com
PUBLIC_URL=
# https://d2lnojrmgxqgrc.cloudfront.net
IMAGE_BASE_URL=
# Firebase 서비스 계정 키 JSON 한 줄 (jq -c . <키 파일>.json), SecureString
FIREBASE_SERVICE_ACCOUNT_JSON=
KAKAO_REST_API_KEY=
# 카카오 Client Secret 을 안 쓰면 파라미터를 만들지 않음
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICES_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오맵 JavaScript 키 (업체 상세 지도). 카카오 콘솔에 https://app.makkigo.com 을 등록해야 함
KAKAO_MAP_APP_KEY=

# ── 요원 앱 ─ /makkigo/prod/valetagents/<이름> ───────────────────────────
DATABASE_URL=
AUTH_JWT_SECRET=
# https://valet.makkigo.com
PUBLIC_URL=
OAUTH_CALLBACK_ORIGIN=
# com.makkigo.valetagent://auth
APP_CALLBACK_URL=
# .makkigo.com
AUTH_COOKIE_DOMAIN=
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_SERVICES_ID=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 카카오맵 JavaScript 키 (부스 위치 지도). 카카오 콘솔에 https://valet.makkigo.com 을 등록해야 함
KAKAO_MAP_APP_KEY=

# ── 배포 ─ /makkigo/prod/deploy/<이름> ──────────────────────────────────────
# 서버가 GHCR(GitHub Packages)의 비공개 이미지를 받을 때 씀
# GitHub 계정 이름
GHCR_USERNAME=
# GitHub Personal Access Token (classic) — 권한 read:packages 만
GHCR_TOKEN=

# ── GitHub Actions 저장소 Secrets (Settings → Secrets and variables → Actions) ─
# 파일이 아니라 GitHub 에 등록합니다.
# 운영 비밀값은 여기가 아니라 SSM 에 둡니다. Actions 는 AWS 접속 키 없이 OIDC 로 IAM 역할을 맡고,
# SSM 명령 실행으로 EC2 에 배포합니다 (SSH 포트를 열지 않음).
# Actions 가 AWS 에 접속할 때 맡을 IAM 역할 ARN
AWS_DEPLOY_ROLE_ARN=
# 배포 명령을 보낼 EC2 인스턴스 ID (i-로 시작)
EC2_INSTANCE_ID=
