model Staff {
  id        Int        @id @default(autoincrement())
  role      StaffRole?
  name      String?
  phone     String?
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime?  @map("deleted_at") @db.Timestamptz(3)

  socialAccounts StaffSocialAccount[]
  refreshTokens  StaffRefreshToken[]
  loginCodes     StaffLoginCode[]
  pushDevices    PushDevice[]
  notifications  Notification[]

  boothMemberships BoothAgent[]
  createdBooths    Booth[]      @relation("BoothCreator")
  merchants        Merchant[]

  parkedSessions    ValetSession[] @relation("SessionParkedBy")
  respondedSessions ValetSession[] @relation("SessionRespondedBy")
  completedSessions ValetSession[] @relation("SessionCompletedBy")

  @@map("staff")
}

model StaffSocialAccount {
  id             Int            @id @default(autoincrement())
  staffId        Int            @map("staff_id")
  provider       SocialProvider
  providerUserId String         @map("provider_user_id")
  email          String?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([staffId])
  @@map("staff_social_accounts")
}

model StaffRefreshToken {
  id         Int       @id @default(autoincrement())
  staffId    Int       @map("staff_id")
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  userAgent  String?   @map("user_agent")
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiresAt])
  @@map("staff_refresh_tokens")
}

model StaffLoginCode {
  id           Int       @id @default(autoincrement())
  staffId      Int       @map("staff_id")
  codeHash     String    @unique @map("code_hash") @db.Char(64)
  appChallenge String    @map("app_challenge") @db.Char(43)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt       DateTime? @map("used_at") @db.Timestamptz(3)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  staff Staff @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiresAt])
  @@map("staff_login_codes")
}
