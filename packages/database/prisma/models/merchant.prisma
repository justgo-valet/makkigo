model Merchant {
    id             Int       @id @default(autoincrement())
    name           String
    address        String
    addressDetail  String?   @map("address_detail")
    postalCode     String?   @map("postal_code")
    latitude       Float?
    longitude      Float?
    kakaoPlaceId   String?   @unique @map("kakao_place_id")
    phone          String?
    publicDataId   String?   @unique @map("public_data_id")
    category       String?
    importTargetId Int?      @map("import_target_id")
    createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
    deletedAt      DateTime? @map("deleted_at") @db.Timestamptz(3)

    admins             MerchantAdmin[]
    photos             MerchantPhoto[]
    booths             BoothMerchant[]
    tickets            Ticket[]
    valetSessions      ValetSession[]
    ticketImageUploads TicketImageUpload[]
    importTarget       MerchantImportTarget? @relation(fields: [importTargetId], references: [id], onDelete: SetNull)

    @@index([name])
    @@index([importTargetId])
    @@map("merchants")
}

model MerchantPhoto {
    id         Int      @id @default(autoincrement())
    merchantId Int      @map("merchant_id")
    path       String
    sortOrder  Int      @map("sort_order")
    createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

    merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

    @@index([merchantId, sortOrder])
    @@map("merchant_photos")
}

model BoothMerchant {
    boothId    Int                 @map("booth_id")
    merchantId Int                 @map("merchant_id")
    status     BoothMerchantStatus @default(PENDING)
    createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

    booth    Booth    @relation(fields: [boothId], references: [id], onDelete: Cascade)
    merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)

    @@id([boothId, merchantId])
    @@index([merchantId, status])
    @@map("booth_merchants")
}
