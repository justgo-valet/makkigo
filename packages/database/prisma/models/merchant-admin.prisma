model MerchantAdmin {
    id                     Int       @id @default(autoincrement())
    loginId                String    @unique @map("login_id")
    passwordHash           String    @map("password_hash")
    name                   String
    merchantId             Int?      @map("merchant_id")
    passwordChangeRequired Boolean   @default(true) @map("password_change_required")
    failedLoginCount       Int       @default(0) @map("failed_login_count")
    lockedUntil            DateTime? @map("locked_until") @db.Timestamptz(3)
    disabledAt             DateTime? @map("disabled_at") @db.Timestamptz(3)
    createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
    updatedAt              DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

    merchant           Merchant?                    @relation(fields: [merchantId], references: [id])
    refreshTokens      MerchantAdminRefreshToken[]
    ticketImageUploads TicketImageUpload[]
    accountRequests    MerchantAccountRequest[]

    @@index([merchantId])
    @@map("merchant_admins")
}

model MerchantAdminRefreshToken {
    id              Int       @id @default(autoincrement())
    merchantAdminId Int       @map("merchant_admin_id")
    tokenHash       String    @unique @map("token_hash") @db.Char(64)
    userAgent       String?   @map("user_agent")
    expiresAt       DateTime  @map("expires_at") @db.Timestamptz(3)
    revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(3)
    lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(3)
    createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

    merchantAdmin MerchantAdmin @relation(fields: [merchantAdminId], references: [id], onDelete: Cascade)

    @@index([merchantAdminId])
    @@index([expiresAt])
    @@map("merchant_admin_refresh_tokens")
}
