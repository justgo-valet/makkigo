{$USERS_DOMAIN} {
	encode zstd gzip
	handle /api/internal/* {
		respond 403
	}
	handle /api/v1/staff/auth/oauth/* {
		reverse_proxy valetagents:3000
	}
	handle {
		reverse_proxy users:3001
	}
}

{$VALET_DOMAIN} {
	encode zstd gzip
	handle /api/internal/* {
		respond 403
	}
	handle {
		reverse_proxy valetagents:3000
	}
}
