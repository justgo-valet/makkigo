(security_headers) {
	header {
		defer
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		-X-Powered-By
	}
}

{$USERS_DOMAIN} {
	encode zstd gzip
	import security_headers
	handle /api/internal/* {
		respond 403
	}
	handle /api/v1/staff/auth/oauth/* {
		reverse_proxy valetagents:3000
	}
	handle {
		reverse_proxy users:3001
	}
}

{$VALET_DOMAIN} {
	encode zstd gzip
	import security_headers
	handle /api/internal/* {
		respond 403
	}
	handle {
		reverse_proxy valetagents:3000
	}
}

{$TICKETS_DOMAIN} {
	encode zstd gzip
	import security_headers
	handle /api/internal/* {
		respond 403
	}
	handle {
		reverse_proxy tickets:3002
	}
}

{$ADMIN_DOMAIN} {
	encode zstd gzip
	import security_headers
	handle /api/internal/* {
		respond 403
	}
	handle {
		reverse_proxy admin:3003
	}
}
